<Window x:Class="SteamSwitchboard.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename profile nickname"
        Icon="{StaticResource AppIcon}"
        Background="{StaticResource BackgroundBrush}"
        Width="500"
        Height="330"
        MinWidth="380"
        MinHeight="280"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="32" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource HeadingText}" Text="Rename profile nickname" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Text="Change the private name shown only in Switchboard. The Steam login and Steam sign-in stay unchanged." />
            <TextBlock x:Name="AccountIdentityText"
                       Margin="0,7,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <Label Target="{Binding ElementName=DisplayNameTextBox}" Content="_Profile nickname" />
            <TextBox x:Name="DisplayNameTextBox"
                     Margin="0,8,0,0"
                     MaxLength="64"
                     AutomationProperties.Name="New profile nickname"
                     TextChanged="OnInputChanged" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource DangerBrush}"
                       FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button MinWidth="130"
                    Content="Save nickname"
                    IsDefault="True"
                    Click="OnSaveClicked"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
