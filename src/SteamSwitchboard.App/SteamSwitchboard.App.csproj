<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SteamSwitchboard</RootNamespace>
    <AssemblyName>SteamSwitchboard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\SteamSwitchboard.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Loading the self-contained Windows App SDK from its module initializer
         delays the first WPF input by several seconds. SteamSwitchboard loads
         the same runtime explicitly on a worker thread when alerts are enabled. -->
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <WebView2UseWinRT>false</WebView2UseWinRT>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>1.0.1</Version>
    <Authors>SteamSwitchboard contributors</Authors>
    <Product>SteamSwitchboard</Product>
    <Copyright>Copyright © 2026 SteamSwitchboard contributors</Copyright>
    <Description>An unofficial multi-account workspace for Steam chat and account-aware game launching.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- App notifications live in Foundation; Runtime supplies the app-local
         implementation. Avoid the aggregate SDK's unrelated AI/ML/WinUI payload. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\SteamSwitchboard.ico" />
    <None Remove="Assets\Branding\SteamSwitchboard-app-logo.png" />
    <None Remove="Assets\Branding\SteamSwitchboard-logo-v1.png" />
    <Resource Include="Assets\SteamSwitchboard.ico" />
    <Content Include="Assets\Branding\SteamSwitchboard-app-logo.png"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Branding\SteamSwitchboard-logo-v1.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
