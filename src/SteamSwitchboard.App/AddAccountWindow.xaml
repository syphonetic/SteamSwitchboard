<Window x:Class="SteamSwitchboard.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a Steam account"
        Icon="{StaticResource AppIcon}"
        Background="{StaticResource BackgroundBrush}"
        Width="540"
        Height="590"
        MinWidth="500"
        MinHeight="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="32" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Add an account" Style="{StaticResource HeadingText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text="Give the account a clear label. You will sign in directly on Steam's website after it is added." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,20">
            <TextBlock Text="Profile name" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,8"
                       Style="{StaticResource MutedText}"
                       Text="What you want to see in Switchboard, such as Main or Trading." />
            <TextBox x:Name="DisplayNameTextBox"
                     MaxLength="64"
                     AutomationProperties.Name="Switchboard profile name"
                     TextChanged="OnInputChanged" />

            <TextBlock Margin="0,22,0,0" Text="Steam account name" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,8"
                       Style="{StaticResource MutedText}"
                       Text="The account name shown by Steam's account switcher—not your password or email." />
            <TextBox x:Name="SteamLoginNameTextBox"
                     MaxLength="64"
                     AutomationProperties.Name="Steam account name"
                     TextChanged="OnInputChanged" />

            <TextBlock Margin="0,22,0,8" Text="Profile color" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BlueAccent" GroupName="Accent" IsChecked="True" Tag="#66C0F4" Margin="0,0,16,0" AutomationProperties.Name="Blue profile color">
                    <Ellipse Width="28" Height="28" Fill="#66C0F4" />
                </RadioButton>
                <RadioButton GroupName="Accent" Tag="#55D99A" Margin="0,0,16,0" AutomationProperties.Name="Green profile color">
                    <Ellipse Width="28" Height="28" Fill="#55D99A" />
                </RadioButton>
                <RadioButton GroupName="Accent" Tag="#B99CFF" Margin="0,0,16,0" AutomationProperties.Name="Purple profile color">
                    <Ellipse Width="28" Height="28" Fill="#B99CFF" />
                </RadioButton>
                <RadioButton GroupName="Accent" Tag="#FFB86B" Margin="0,0,16,0" AutomationProperties.Name="Orange profile color">
                    <Ellipse Width="28" Height="28" Fill="#FFB86B" />
                </RadioButton>
                <RadioButton GroupName="Accent" Tag="#FF7CA8" AutomationProperties.Name="Pink profile color">
                    <Ellipse Width="28" Height="28" Fill="#FF7CA8" />
                </RadioButton>
            </StackPanel>

            <Border Margin="0,24,0,0"
                    Padding="14"
                    Background="#102738"
                    BorderBrush="#24506B"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           Text="Privacy: Switchboard never asks for, reads, or stores your Steam password or Steam Guard code. After adding, sign this same account into Steam's page; Steam's page controls the identity that sends messages." />
            </Border>

            <TextBlock x:Name="ValidationText"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource DangerBrush}"
                       FontWeight="SemiBold"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button x:Name="AddButton"
                    MinWidth="130"
                    Content="Add account"
                    IsDefault="True"
                    Click="OnAddClicked"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
