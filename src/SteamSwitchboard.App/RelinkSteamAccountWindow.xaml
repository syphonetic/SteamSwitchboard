<Window x:Class="SteamSwitchboard.RelinkSteamAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relink Steam login"
        Icon="{StaticResource AppIcon}"
        Background="{StaticResource BackgroundBrush}"
        Width="570"
        Height="440"
        MinWidth="430"
        MinHeight="360"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="32" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource HeadingText}" Text="Relink Steam login" />
            <TextBlock x:Name="ProfileIdentityText"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,7,0,0"
                       Style="{StaticResource MutedText}"
                       Text="Choose an account detected in the local Steam client. This changes only the login used by the launch guard; it does not sign in, move cookies, or change the chat workspace." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,24,0,20"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <Label Target="{Binding ElementName=DetectedAccountsComboBox}"
                       Content="_Detected Steam login" />
                <ComboBox x:Name="DetectedAccountsComboBox"
                          Margin="0,8,0,0"
                          DisplayMemberPath="DisplayText"
                          AutomationProperties.Name="Detected Steam login"
                          SelectionChanged="OnSelectionChanged" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource MutedText}"
                           Text="Steam persona names are shown only to help you recognize each login." />

                <Border Margin="0,22,0,0"
                        Padding="14"
                        Background="#2A2111"
                        BorderBrush="#6B5420"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Foreground="#E9D9B3"
                               TextWrapping="Wrap"
                               Text="Safety check: after relinking, Switchboard will still launch only when Steam reports this exact login as active. Steam remains in control of account switching and ownership prompts." />
                </Border>

                <TextBlock x:Name="ValidationText"
                           Margin="0,14,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button x:Name="RelinkButton"
                    MinWidth="150"
                    Content="Relink login"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OnRelinkClicked"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
