<Window x:Class="SteamSwitchboard.AccountSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose the play account in Steam"
        Icon="{StaticResource AppIcon}"
        Background="{StaticResource BackgroundBrush}"
        Width="590"
        Height="430"
        MinWidth="540"
        MinHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="32" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="One quick check in Steam" Style="{StaticResource HeadingText}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MutedText}"
                       Text="Steam's desktop client supports one account at a time. Switchboard will wait and launch only after the correct account is active." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,26,0,22" Style="{StaticResource CardBorder}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="InstructionText"
                           FontSize="17"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="StatusText"
                           Margin="0,14,0,0"
                           Foreground="{StaticResource WarningBrush}"
                           TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="WaitingProgress"
                             Margin="40,24,40,0"
                             Height="4"
                             IsIndeterminate="True" />
                <TextBlock Margin="0,22,0,0"
                           Style="{StaticResource MutedText}"
                           TextAlignment="Center"
                           Text="Your Switchboard chat sessions remain signed in while Steam changes its play account." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button x:Name="OpenSteamButton"
                    MinWidth="130"
                    Content="Open Steam"
                    Click="OnOpenSteamClicked"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
